@baseUrl = https://aps-codepen.autodesk.io

### 1. GET Token
# @name getToken
GET {{baseUrl}}/api/token HTTP/1.1

/*
Expected JSON Response:
HTTP/1.1 200 OK
Content-Type: application/json

{
  "access_token": "eyJhbGciOiJSUzI1NiIsImtpZCI6IlZiakZvUzhQU3lYODQyMV95dndvRUdRdFJEa19SUzI1NiIsInBpLmF0bSI6ImFzc2MifQ...",
  "token_type": "Bearer",
  "expires_in": 3599,
  "expires_at": 1790432280245
}
*/

### Store token into variable
@accessToken = {{getToken.response.body.access_token}}

### 2. List Models (No Auth required)
# @name listModels
GET {{baseUrl}}/api/models HTTP/1.1

